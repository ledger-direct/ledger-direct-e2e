# ledger-direct-e2e — the variables the harness reads. Testnet only.
#
# The program knows no file. Copy this to a place OUTSIDE every repository, e.g.
#   ~/.config/ledger-direct/testnet.env   (chmod 600)
# fill in the values, and load it into the shell before running:
#   set -a; source ~/.config/ledger-direct/testnet.env; set +a
# In CI the same names are organisation secrets. Never commit a filled-in copy.

# One treasury per chain: pays test orders, funds fresh accounts. Create with
#   ld-e2e wallet fresh --trustlines            (XRPL, then top up tokens on the DEX)
#   ld-e2e --chain STELLAR wallet fresh         (Stellar, via Friendbot)
LEDGERDIRECT_TESTNET_XRPL_TREASURY_ADDRESS=r...
LEDGERDIRECT_TESTNET_XRPL_TREASURY_SEED=s...
LEDGERDIRECT_TESTNET_STELLAR_TREASURY_ADDRESS=G...
LEDGERDIRECT_TESTNET_STELLAR_TREASURY_SEED=S...

# Optional, per shop: how it is reached (--base-url) and, where the driver runs
# commands inside the shop's compose stack, that stack's folder (--compose-dir).
# LD_E2E_PRESTASHOP_BASE_URL=http://localhost:8080
# LD_E2E_PRESTASHOP_COMPOSE_DIR=/path/to/prestashop-harness
# LD_E2E_SHOPWARE_BASE_URL=http://localhost
# LD_E2E_SHOPWARE_ACCESS_KEY=SW...            the sales channel access key
# LD_E2E_SHOPWARE_CONTAINER=shopware6_672-shopware-1
# LD_E2E_WOOCOMMERCE_BASE_URL=http://localhost:8082
# LD_E2E_WOOCOMMERCE_COMPOSE_DIR=/path/to/wordpress-stack
# LD_E2E_WOOCOMMERCE_COMPOSE_FILES=docker-compose.yml,docker-compose.ports-local.yml
# LD_E2E_MAGENTO_BASE_URL=https://localhost:8444
# LD_E2E_MAGENTO_COMPOSE_DIR=/path/to/magento-stack
# LD_E2E_MAGENTO_ADMIN_USER=...                admin REST credentials, if not the dev-stack defaults
# LD_E2E_MAGENTO_ADMIN_PASSWORD=...
# LD_E2E_MAX_PAYMENT=50                        the MCP server refuses larger payments
